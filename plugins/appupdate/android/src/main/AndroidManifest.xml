<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- lets the app hand an APK to the system installer; the user still confirms -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!--
            Its own provider with its own authority, so the plugin never depends on what
            the app happens to have in file_paths.xml. The installer runs in another
            process and can only read the file through this.
        -->
        <provider
            android:name="de.friedl.renomaster.appupdate.UpdateFileProvider"
            android:authorities="${applicationId}.updateprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/reno_update_paths" />
        </provider>
    </application>
</manifest>
