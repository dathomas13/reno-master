# Firebase web config - copy from the Firebase console (project settings, web app).
# These values are not secret; they identify the project and are shipped to the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=reno-master.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=reno-master
VITE_FIREBASE_STORAGE_BUCKET=reno-master.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web push certificate (Cloud Messaging, "Web Push certificates" - public key)
VITE_VAPID_KEY=

# 1 = talk to the local Firebase emulators instead of the real project
VITE_USE_EMULATORS=

# Adresse des Cloudflare-Workers, der die Dateien verwaltet (siehe worker/README.md)
VITE_FILES_URL=https://reno-files.beispiel.workers.dev
