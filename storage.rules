rules_version = '2';

// Photos, receipts and uploaded plans. Same two accounts, 30 MB per file.
service firebase.storage {
  match /b/{bucket}/o {
    // lower cased on both sides: Firebase normalises addresses, a capital letter in the
    // list below would lock that account out
    function allowed() {
      return request.auth != null
        && request.auth.token.email.lower() in [
             'thomas_email_hier_eintragen',
             'sarah_email_hier_eintragen'
           ];
    }

    match /{allPaths=**} {
      allow read: if allowed();
      allow write: if allowed() && request.resource.size < 30 * 1024 * 1024;
    }
  }
}
