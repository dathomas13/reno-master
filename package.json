{
  "name": "reno-master",
  "version": "0.29.6",
  "private": true,
  "type": "module",
  "description": "Renovierungs-App für Schlesierstraße 31 – 3D-Modell, Bautagebuch, Pläne, Kosten, Aufgaben, Kontakte",
  "scripts": {
    "android:open": "npx cap open android",
    "android:sync": "npm run build:app && npx cap sync android",
    "build": "tsc --noEmit && vite build",
    "icons": "node tools/icon/build-icons.mjs",
    "build:app": "CAP=1 vite build",
    "check:offline": "node tools/verify/typecheck-without-npm.mjs && node tools/verify/run-tests-without-npm.mjs",
    "dev": "vite",
    "dev:emu": "VITE_USE_EMULATORS=1 vite",
    "e2e": "playwright test",
    "emulators": "firebase emulators:start --only auth,firestore",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "lint": "eslint .",
    "model:manifest": "python3 tools/model/make_manifest.py",
    "model:plans": "python3 tools/model/build_plans_svg.py",
    "model:rooms": "python3 tools/model/build_rooms.py",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "worker:test": "node worker/selftest.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/camera": "^6.1.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/local-notifications": "^6.1.2",
    "@capacitor/share": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "@reno/mediastore": "file:plugins/mediastore",
    "@reno/appupdate": "file:plugins/appupdate",
    "@reno/fileexport": "file:plugins/fileexport",
    "exifr": "^7.1.3",
    "firebase": "^11.0.2",
    "idb": "^8.0.0",
    "nanoid": "^5.0.9",
    "pdfjs-dist": "^4.9.155",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.5",
    "workbox-cacheable-response": "^7.3.0",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0",
    "workbox-window": "^7.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
